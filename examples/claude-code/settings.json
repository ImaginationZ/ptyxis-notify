{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "ptyxis-notify", "timeout": 10 }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          { "type": "command", "command": "ptyxis-notify", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          { "type": "command", "command": "ptyxis-notify", "timeout": 10 }
        ]
      }
    ]
  }
}
